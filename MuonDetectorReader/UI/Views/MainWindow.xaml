<mah:MetroWindow x:Class="MuonDetectorReader.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:oxy="http://oxyplot.org/wpf"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                xmlns:conv="clr-namespace:MuonDetectorReader.Converters"
                mc:Ignorable="d" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
                Title="Muon Detector Reader" MinHeight="700" MinWidth="970" Height="700" Width="970"
                TitleCharacterCasing="Normal"
                 
                WindowTitleBrush="#0f7674"
                NonActiveWindowTitleBrush="#0f7674"
                BorderBrush="#0f7674"
                OverlayBrush="#1f1f1f"
                FlyoutOverlayBrush="#6F1f1f1f"
                 
                Icon="/42696comet_99009.ico" FontSize="12" FontFamily="Trebuchet MS">
    
    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock FontFamily="Trebuchet MS" FontWeight="Black"
                   FontSize="{DynamicResource MahApps.Font.Size.Window.Title}"
                   VerticalAlignment="Center">
                <Run Text=" "/>
                <Run Text="{TemplateBinding Content}"/>
            </TextBlock>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>
    <!-- Title bar commands: Help, Theme, Language -->
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button Content="?" FontWeight="Bold" FontSize="15"
                    Click="ShowHelpClick" x:Name="HelpButton"
                    IsEnabled="{Binding IsGraphPanelEnabled}"
                    ToolTip="{DynamicResource Str_HelpTooltip}"/>
            <Button FontWeight="Bold" FontSize="16"
                    Content="{Binding ToggleSidebarIcon}" 
                    Command="{Binding ToggleSidebarCommand}"
                    ToolTip="{Binding ToggleSidebarTooltip}"/>
            <Button Content="🎨" FontSize="14"
                    Click="ToggleThemeClick"
                    ToolTip="{DynamicResource Str_ThemeTooltip}"/>
            <Button Content="🌐" FontSize="14"
                    Command="{Binding ToggleLanguageCommand}"
                    ToolTip="{DynamicResource Str_LanguageTooltip}"/>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <!-- Flyout for Double Graph panel -->
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout Header="{DynamicResource Str_OtherGraph}"
                        Width="220"
                        IsOpen="{Binding IsDoubleGraphFlyoutOpen, Mode=TwoWay}"
                        Theme="Adapt"
                        IsPinned="False"
                        IsModal="True"
                        AnimateOpacity="True">
                <mah:Flyout.Style>
                    <Style TargetType="mah:Flyout">
                        <Style.Triggers>
                            <DataTrigger  Binding="{Binding IsSidebarOnRight}" Value="False">
                                <Setter Property="mah:Flyout.Position" Value="Left"/>
                            </DataTrigger>
                            <DataTrigger  Binding="{Binding IsSidebarOnRight}" Value="True">
                                <Setter Property="mah:Flyout.Position" Value="Right"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </mah:Flyout.Style>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left column: counts -->
                    <TextBlock Text="{DynamicResource Str_LeftYAxis}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <CheckBox Content="{DynamicResource Str_RawCountsShort}" IsChecked="{Binding IsDgCgChecked, Mode=TwoWay}" Margin="0,4"/>
                        <CheckBox Content="{DynamicResource Str_PressCorrShort}" IsChecked="{Binding IsDgCcpChecked, Mode=TwoWay}" Margin="0,4"/>
                        <CheckBox Content="{DynamicResource Str_PressTempCorrShort}" IsChecked="{Binding IsDgCcptChecked, Mode=TwoWay}" Margin="0,4"/>
                    </StackPanel>

                    <!-- Right column: meteorological -->
                    <TextBlock Grid.Row="2" Text="{DynamicResource Str_RightYAxis}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="3">
                        <CheckBox Content="{DynamicResource Str_PressureShort}" IsChecked="{Binding IsDgPChecked, Mode=TwoWay}" Margin="0,4"/>
                        <CheckBox Content="{DynamicResource Str_TemperatureShort}" IsChecked="{Binding IsDgTChecked, Mode=TwoWay}" Margin="0,4"/>

                        <Separator Margin="0,15,0,10"/>
                        <Button Content="OK" Command="{Binding DoubleGraphOkCommand}"
                                HorizontalAlignment="Right" Width="80" Height="30"
                                Background="{DynamicResource MahApps.Brushes.AccentBase}"/>
                    </StackPanel>
                </Grid>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>

    <!-- Main content -->
    <Border BorderThickness="1 0 1 1" BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}">
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeftColumnWidth, FallbackValue=Auto}"/>
                <ColumnDefinition Width="{Binding RightColumnWidth, FallbackValue=*}"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════ -->
            <!-- SIDEBAR: Controls                       -->
            <!-- ═══════════════════════════════════════ -->
            <Border Grid.Column="{Binding SidebarColumn, FallbackValue=0}"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent4}"
                    BorderThickness="{Binding SidebarBorderThickness}"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10 0">

                        <!-- FILE SECTION -->
                        <GroupBox Header="{DynamicResource Str_FileHeader}" Margin="0,0,0,8"
                                    Style="{DynamicResource MetroSidebarGroupBox}">
                            <Button Command="{Binding OpenFileCommand}" Height="30"
                                    Content="{DynamicResource Str_OpenFile}"
                                    HorizontalAlignment="Stretch"/>
                        </GroupBox>

                            <!-- DATA CORRECTION SECTION -->
                        <GroupBox Header="{DynamicResource Str_DataCorrectionHeader}" Margin="0,0,0,8"
                                  Style="{DynamicResource MetroSidebarGroupBox}">
                            <StackPanel IsEnabled="{Binding IsBetaPanelEnabled}">
                                <!-- Outlier removal -->
                                <DockPanel Margin="0,2">
                                    <mah:ToggleSwitch  DockPanel.Dock="Right" 
                                              IsEnabled="{Binding IsOutlierBoxEnabled}" 
                                              IsOn="{Binding IsOutlierChecked, Mode=TwoWay}"/>
                                    <TextBlock Text="{DynamicResource Str_RemoveOutliers}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <StackPanel Margin="0,2">
                                    <DockPanel>
                                        <TextBlock Text="{Binding OutlierSigmaText}" DockPanel.Dock="Right"/>
                                        <TextBlock Text="{DynamicResource Str_OutlierSigma}"/>
                                    </DockPanel>
                                    <Slider IsEnabled="{Binding IsOutlierSliderEnabled}"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="0.25" Minimum="2" Maximum="5"
                                            Value="{Binding OutlierSigmaValue, Mode=TwoWay}"
                                            TickPlacement="BottomRight" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Beta section -->
                                <Border Margin="-1,6" CornerRadius="{StaticResource GlobalCornerRadius}" 
                                        BorderBrush="{DynamicResource MahApps.Brushes.AccentBase}" BorderThickness="1">
                                    <StackPanel>
                                        <Border CornerRadius="2 2 0 0" Background="{DynamicResource MahApps.Brushes.AccentBase}" 
                                                Padding="2" Margin="-1, 0">
                                            <TextBlock Text="{DynamicResource Str_BarometricCoeff}" HorizontalAlignment="Center" FontWeight="Bold"
                                                       Foreground="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                        </Border>
                                        <DockPanel Margin="0,6,0,2">
                                            <Button DockPanel.Dock="Left"
                                                    Command="{Binding EstimateBetaCommand}"
                                                    Width="70" Height="26" Margin="5 0 0 0"
                                                    Content="{DynamicResource Str_EstimateBeta}"
                                                    Background="{DynamicResource SidebarBetaBrush}" 
                                                    Foreground="White"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding ReferencePressureText, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="55" Height="22" Margin="5 0"
                                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                         PreviewTextInput="PressBoxInput" PreviewKeyDown="PressBoxPreviewKeyDown"/>
                                                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center">        
                                                    <Run Text="P0" FontStyle="Italic" FontWeight="Bold"/>
                                                    <Run Text="(hPa)" Foreground="{DynamicResource MahApps.Brushes.Gray2}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>

                                        <StackPanel Margin="0,4" HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{DynamicResource Str_SavedBeta}"/>
                                                <Run Text=" "/>
                                            </TextBlock>

                                            <TextBlock Text="{Binding BetaText, Mode=OneWay}" 
                                                     IsHitTestVisible="False" Width="60" FontWeight="Black"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- GRAPH BUTTONS SECTION -->
                        <GroupBox Header="{DynamicResource Str_GraphsHeader}" Margin="0,0,0,8"
                                  Style="{DynamicResource MetroSidebarGroupBox}"
                                  IsEnabled="{Binding IsGraphPanelEnabled}">
                            <StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <Button Command="{Binding ShowRawCountsCommand}" Height="28" Margin="0,0,3,4"
                                            Content="{DynamicResource Str_RawCounts}"
                                            Background="{DynamicResource SidebarGraphRawBrush}"
                                            Foreground="White"/>
                                    <Button Command="{Binding ShowCorrectedCountsCommand}" Height="28" Margin="3,0,0,4"
                                            Content="{DynamicResource Str_CorrectedCounts}"
                                            Background="{DynamicResource SidebarGraphCorrectedBrush}"
                                            Foreground="White"/>
                                    <Button Command="{Binding ShowPressureCommand}" Height="28" Margin="0,0,3,4"
                                            Content="{DynamicResource Str_Pressure}"
                                            Background="{DynamicResource SidebarGraphPressureBrush}"
                                            Foreground="White"/>
                                    <Button Command="{Binding ShowTemperatureCommand}" Height="28" Margin="3,0,0,4"
                                            Content="{DynamicResource Str_Temperature}"
                                            Background="{DynamicResource SidebarGraphTemperatureBrush}"
                                            Foreground="White"/>
                                </UniformGrid>

                                <Button Command="{Binding ShowDoubleGraphPanelCommand}"
                                        Height="28" Margin="0,2,0,6"
                                        Content="{DynamicResource Str_OtherGraphBtn}"
                                        Background="{DynamicResource SidebarDoubleGraphBrush}"
                                        Foreground="White"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- OPTIONS SECTION -->
                        <GroupBox Header="{DynamicResource Str_OptionsHeader}" Margin="0,0,0,8"
                                  Style="{DynamicResource MetroSidebarGroupBox}"
                                  IsEnabled="{Binding IsGraphPanelEnabled}">
                            <StackPanel>
                            
                                <!-- Moving average -->
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding SmoothValueText}" DockPanel.Dock="Right" Margin="4,0"/>
                                        <TextBlock Text="{DynamicResource Str_MovingAverage}"/>
                                    </DockPanel>
                                    <Slider IsEnabled="{Binding IsAvgSliderEnabled}"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="2" Minimum="0" Maximum="48"
                                            Value="{Binding AvgSliderValue, Mode=TwoWay}"
                                            TickPlacement="BottomRight" Margin="0,4,0,0"/>
                                </StackPanel>
                            
                                <!-- Temperature correction -->
                                <DockPanel >
                                    <mah:ToggleSwitch DockPanel.Dock="Right"
                                              IsEnabled="{Binding IsTempCorrEnabled}"
                                              IsOn="{Binding IsTempCorrChecked, Mode=TwoWay}">
                                        <mah:ToggleSwitch.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{DynamicResource Str_EkarOnlyTooltip}" FontWeight="Bold"/>
                                            </ToolTip>
                                        </mah:ToggleSwitch.ToolTip>
                                    </mah:ToggleSwitch>
                                    <TextBlock Text="{DynamicResource Str_TempCorrection}" VerticalAlignment="Center">
                                        <TextBlock.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{DynamicResource Str_EkarOnlyTooltip}" FontWeight="Bold"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DockPanel>

                                <!-- Data mask -->
                                <DockPanel>
                                    <mah:ToggleSwitch DockPanel.Dock="Right"
                                              IsEnabled="{Binding IsShowHideDataEnabled}"
                                              IsOn="{Binding IsShowHideDataChecked, Mode=TwoWay}"/>
                                    <TextBlock Text="{DynamicResource Str_DataMask}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- EXPORT SECTION -->
                        <GroupBox Header="{DynamicResource Str_ExportHeader}" Margin="0,0,0,0"
                                  Style="{DynamicResource MetroSidebarGroupBox}"
                                  IsEnabled="{Binding IsExportPanelEnabled}">
                            <Button Command="{Binding ExportFileCommand}" Height="30"
                                    Content="{DynamicResource Str_ExportFile}"
                                    HorizontalAlignment="Stretch"/>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!-- RIGHT AREA: Chart toolbar + Chart       -->
            <!-- ═══════════════════════════════════════ -->
            <Grid Grid.Column="{Binding ContentColumn, FallbackValue=1}">

                <!-- Welcome / Help message, visible when no plot is shown 
                               -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsMessageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Top" Margin="20">
                        <StackPanel HorizontalAlignment="Center"  Orientation="Horizontal">
                            <TextBlock Text="{Binding WindowTitle}" FontSize="32" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                   FontWeight="Black" Margin="0 0 0 0"/>
                            <TextBlock Text="{Binding MinorVersion}" FontSize="12" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                   FontWeight="Black" Margin="2 0 0 4" Opacity=".5"/>
                        </StackPanel>
                        <Separator Background="{DynamicResource MahApps.Brushes.Accent3}"/>
                        <TextBlock HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,0,0,15">
                            <LineBreak/>
                            <Run Text="{DynamicResource Str_Help_ClickOn}"
                                 FontSize="22"
                                 FontWeight="Normal"/>
                            <Run Text="{DynamicResource Str_OpenFile}"
                                 FontSize="22"
                                 FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_ToReadData}"
                                 FontSize="22"
                                 FontWeight="Normal"/>
                            <LineBreak/>

                            <Run Text="{DynamicResource Str_Help_BetaNote}"
                                 FontSize="16"
                                 Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                                 />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="16" 
                                   HorizontalAlignment="Center" TextAlignment="Left">
                            <Run Text="{DynamicResource Str_Help_DataFormat}"
                                 FontWeight="Bold"
                                 TextDecorations="Underline"/>
                            <LineBreak/>
                            <Run Text="{DynamicResource Str_Help_FormatInfo}"/>
                            <LineBreak/>
                            <Run Text="{DynamicResource Str_Help_DateAndTime}" FontStyle="Italic" FontWeight="Bold"/>
                            <Run Text=" * "/>
                            <Run Text="{DynamicResource Str_Help_Temp}" FontStyle="Italic" FontWeight="Bold"/>
                            <Run Text=" * "/>
                            <Run Text="{DynamicResource Str_Help_Pressure}" FontStyle="Italic" FontWeight="Bold"/>
                            <Run Text=" * "/>
                            <Run Text="{DynamicResource Str_Help_Counts}" FontStyle="Italic" FontWeight="Bold"/>
                            <LineBreak/>
                            <LineBreak/>

                            <Run Text="{DynamicResource Str_Help_GuideTitle}"
                                 FontWeight="Bold"
                                 TextDecorations="Underline"/>
                            <LineBreak/>

                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_RemoveOutliers}"
                                 FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_OutliersDesc}"/>
                            <Run Text="{DynamicResource Str_Help_MeanPlusMinus}" FontStyle="Italic"/> <Run Text="{DynamicResource Str_Help_WithAdjacent}"/>
                            <LineBreak/>

                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_TempCorrection}"
                                 FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_TempCorrDesc}"/>
                            <Run Text="{DynamicResource Str_Help_EkarBold}" FontWeight="Bold"/>
                            <LineBreak/>

                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_MovingAverage}"
                                 FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_MovingAvgDesc}"/>
                            <Run Text="N" FontStyle="Italic"/> <Run Text="{DynamicResource Str_Help_PtToReduce}"/>
                            <LineBreak/>

                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_OtherGraph}"
                                 FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_OtherGraphDesc}"/>
                            <LineBreak/>
                            
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_DataMask}"
                                 FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_DataMask}"/>
                            <LineBreak/>

                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_ExportGraph}" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_ExportGraphDesc}"/>
                            <Run Text="png" FontStyle="Italic"/>
                            <Run Text="{DynamicResource Str_Help_OnDesktop}"/>
                            
                            <LineBreak/>
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_ExportFile}" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_ExportFileDesc}"/>
                            <Run Text="txt" FontStyle="Italic"/>
                            <Run Text="{DynamicResource Str_Help_OnDesktop}"/>
                            <LineBreak/>
                            <LineBreak/>

                            <Run Text="{DynamicResource Str_Help_InfoTitle}"
                                 FontWeight="Bold"
                                 TextDecorations="Underline"/>
                            <LineBreak/>
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_Info1}"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="{DynamicResource Str_Help_YAxis1}" FontStyle="Italic"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="{DynamicResource Str_Help_YAxis2}" FontStyle="Italic"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="{DynamicResource Str_Help_YAxis3}" FontStyle="Italic"/>
                            <LineBreak/>

                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_Info2}"/>
                            <LineBreak/>

                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_Info3}"/>
                            <LineBreak/>
                            
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_Info4}"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="{DynamicResource Str_Help_InfoButtonHelp}"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="{DynamicResource Str_Help_InfoButtonSideBar}"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="{DynamicResource Str_Help_InfoButtonTheme}"/>
                            <LineBreak/>
                            <Run Text="  - "/>
                            <Run Text="{DynamicResource Str_Help_InfoButtonLan}"/>
                            <LineBreak/>
                            
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text="{DynamicResource Str_Help_MoreInfo}"/>
                            <Hyperlink NavigateUri="https://sites.google.com/view/marcoparisi/progetti/ekar-muon-detector" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{DynamicResource Str_Help_ClickHere}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- Plot area, visible when a plot exists -->
                <Grid Visibility="{Binding IsPlotVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Chart toolbar: dates + buttons -->
                    <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                            BorderBrush="{DynamicResource MahApps.Brushes.Accent4}"
                            BorderThickness="0,0,0,1"
                            Padding="10,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        
                            <!-- Left side: date pickers -->
                            <StackPanel Width="320">
                                <TextBlock Text="{DynamicResource Str_DateSelection}" HorizontalAlignment="Center" Margin="2" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                            IsEnabled="{Binding IsDatePickerEnabled}">
                                    <TextBlock Text="{DynamicResource Str_From}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                                    <conv:CustomDateTimePicker
                                        SelectedDateTime="{Binding DateFrom, Mode=TwoWay}"
                                        DisplayDateStart="{Binding DateMinimum}"
                                        DisplayDateEnd="{Binding DateFromMaximum}"
                                        Focusable="False" Width="120" Margin="0,0,10,0"
                                        SelectedDateFormat="Short"
                                        SelectedTimeFormat="Short" 
                                        IsClockVisible="False" FontFamily="Trebuchet MS"/>
                                    <TextBlock Text="{DynamicResource Str_To}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                                    <conv:CustomDateTimePicker
                                        SelectedDateTime="{Binding DateTo, Mode=TwoWay}"
                                        DisplayDateStart="{Binding DateToMinimum}"
                                        DisplayDateEnd="{Binding DateMaximum}"
                                        Focusable="False" Width="120"
                                        SelectedDateFormat="Short"
                                        SelectedTimeFormat="Short"
                                        IsClockVisible="False" FontFamily="Trebuchet MS"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Chart Mode selector -->
                            <StackPanel Grid.Column="1" Width="120" IsEnabled="{Binding IsYAxisModeEnabled}">
                                <TextBlock Text="{DynamicResource Str_ChartMode}" HorizontalAlignment="Center" Margin="2" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <mah:ToggleSwitch IsOn="{Binding IsSeriesDottedChecked, Mode=TwoWay}" Height="28" Margin="0 -2"/>
                                    <TextBlock Text="{Binding ChartModeText}" VerticalAlignment="Center" Margin="4,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Y-Axis mode selector -->
                            <StackPanel Grid.Column="2" IsEnabled="{Binding IsYAxisModeEnabled}" Width="100">
                                <TextBlock Text="{DynamicResource Str_YAxis}" HorizontalAlignment="Center" Margin="2" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <RadioButton GroupName="YAxisMode"
                                                     Style="{DynamicResource MetroYAxisToggle}"
                                                     IsChecked="{Binding IsYAxisPercentage, Mode=TwoWay}"
                                                     Content="%" ToolTip="{DynamicResource Str_PercentTooltip}"/>
                                    <RadioButton GroupName="YAxisMode"
                                                     Style="{DynamicResource MetroYAxisToggle}"
                                                     IsChecked="{Binding IsYAxisSigma, Mode=TwoWay}"
                                                     Content="σ" ToolTip="{DynamicResource Str_SigmaTooltip}" Margin="4,0"/>
                                    <RadioButton GroupName="YAxisMode"
                                                     Style="{DynamicResource MetroYAxisToggle}"
                                                     IsChecked="{Binding IsYAxisAbsolute, Mode=TwoWay}"
                                                     Content="N" ToolTip="{DynamicResource Str_AbsoluteTooltip}"/>
                                </StackPanel>
                            </StackPanel>
                        
                            <!-- Right side: action buttons "{Binding IsStretchButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Visibility="{Binding IsResetButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"-->
                            <StackPanel Grid.Column="3" Width="190"  HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource Str_GraphCommands}" HorizontalAlignment="Center" Margin="2" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{DynamicResource Str_Reset}" Command="{Binding ResetGraphCommand}"
                                            IsEnabled="{Binding IsResetButtonVisible}" FontWeight="SemiBold"/>
                                    <Button Content="{DynamicResource Str_Stretch}" Command="{Binding StretchGraphCommand}"
                                            IsEnabled="{Binding IsStretchButtonVisible}" FontWeight="SemiBold" Margin="4,0"/>
                                    <Button Content="{DynamicResource Str_Export}" Command="{Binding ExportGraphCommand}"
                                            IsEnabled="{Binding IsExportPanelEnabled}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- OxyPlot chart -->
                    <oxy:PlotView Grid.Row="1" Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                  Model="{Binding CurrentPlotModel}" Controller="{Binding PlotController}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    
</mah:MetroWindow>
